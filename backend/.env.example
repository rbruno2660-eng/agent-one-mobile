# ───────────────────────────────────────
#  Agent One Mobile Store — Backend .env
#  Copie este arquivo para .env e preencha
# ───────────────────────────────────────

NODE_ENV=production
PORT=3001

# PostgreSQL (Neon.tech ou outro PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERAR_SEGREDO_ALEATORIO
JWT_REFRESH_SECRET=GERAR_OUTRO_SEGREDO
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Redis (opcional — WhatsApp queue)
REDIS_URL=redis://localhost:6379

# WhatsApp Business (configurar quando tiver número Meta)
WHATSAPP_TOKEN=PREENCHER_DEPOIS
WHATSAPP_PHONE_ID=PREENCHER_DEPOIS
WHATSAPP_VERIFY_TOKEN=agent-one-webhook-2025
WHATSAPP_APP_SECRET=PREENCHER_DEPOIS

# Frontend URL (CORS)
FRONTEND_URL=https://SEU-FRONTEND.vercel.app

# Log
LOG_LEVEL=info
