# ─── Servidor ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ─── Banco de dados (Railway PostgreSQL) ──────────────────────────────────
# Cole o valor de DATABASE_URL direto do painel Railway → Variables
DATABASE_URL=postgresql://user:password@host:5432/railway

# ─── Redis (Railway Redis plugin) ─────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ─── JWT ──────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_STRING_ALEATORIA_64_BYTES
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRA_STRING_ALEATORIA_64_BYTES
JWT_REFRESH_EXPIRES_IN=7d

# ─── WhatsApp Business Platform ───────────────────────────────────────────
WHATSAPP_TOKEN=EAAxxxxx...          # Token permanente do Meta for Developers
WHATSAPP_VERIFY_TOKEN=DEFINA_UMA_STRING_ALEATORIA
WHATSAPP_APP_SECRET=abc123...       # App Secret → Meta → App Settings → Basic

# ─── Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Frontend ─────────────────────────────────────────────────────────────
# URL do deploy Vercel (sem barra no final)
FRONTEND_URL=https://agent-one.vercel.app
